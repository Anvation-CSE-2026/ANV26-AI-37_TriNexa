# Supabase Authentication & Database
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini API
# Server-side key for AI content generation, style analysis, vision, and assistant
# Never expose this on the client
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Meta / Instagram Graph API Configuration
# Required for official Instagram account connection and direct publishing
# Register your App at https://developers.facebook.com
# App Type: Business
# Products to Add: 'Instagram Graph API' and 'Facebook Login for Business'
# Permissions: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8080/auth/instagram/callback

